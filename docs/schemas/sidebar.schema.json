{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniTools sidebar configuration",
  "type": "object",
  "required": ["format_version", "presentation", "pages"],
  "properties": {
    "format_version": { "const": 3 },
    "default_visible": { "type": "boolean" },
    "refresh_interval_ticks": { "type": "integer", "minimum": 5, "maximum": 600 },
    "conflict_policy": { "enum": ["skip", "replace", "restore"] },
    "presentation": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["fixed", "rotate"] },
        "rotation_ticks": { "type": "integer", "minimum": 20, "maximum": 72000 },
        "fixed_page": { "$ref": "#/$defs/id" },
        "page_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
    "line": {
      "type": "object",
      "required": ["id", "text"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "type": "string", "minLength": 1, "maxLength": 256 } },
      "additionalProperties": false
    },
    "page": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type", "title", "lines"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "text" }, "title": { "type": "string", "maxLength": 64 }, "lines": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "$ref": "#/$defs/line" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "type", "title", "leaderboard_id", "max_entries", "line_format"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "leaderboard" }, "title": { "type": "string", "maxLength": 64 }, "leaderboard_id": { "$ref": "#/$defs/id" }, "max_entries": { "type": "integer", "minimum": 1, "maximum": 15 }, "line_format": { "type": "string", "minLength": 1, "maxLength": 256 } },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
