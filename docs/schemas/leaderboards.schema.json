{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniTools leaderboards configuration",
  "type": "object",
  "required": ["format_version", "leaderboards"],
  "properties": {
    "format_version": { "const": 1 },
    "refresh_interval_ticks": { "type": "integer", "minimum": 20, "maximum": 72000 },
    "include_offline_players": { "type": "boolean" },
    "exclude_zero_scores": { "type": "boolean" },
    "max_files_per_tick": { "type": "integer", "minimum": 1, "maximum": 64 },
    "target_groups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "leaderboards": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/leaderboard" }
    }
  },
  "$defs": {
    "leaderboard": {
      "type": "object",
      "required": ["id", "icon", "stat"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}$" },
        "display": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 256 },
        "icon": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
        "linked_achievement": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}$" },
        "stat": { "$ref": "#/$defs/stat" }
      },
      "additionalProperties": false
    },
    "stat": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["block_mined", "item_crafted", "item_used", "item_broken", "item_picked_up", "item_dropped", "entity_killed", "entity_killed_by", "custom"]
        },
        "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "custom_stat": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
        "aggregation": { "enum": ["sum", "min", "max"] },
        "unit": { "enum": ["count", "cm", "meters", "blocks", "kilometers", "ticks", "seconds", "minutes", "hours", "damage", "hearts"] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "custom" } }, "required": ["type"] },
          "then": { "required": ["custom_stat"], "not": { "required": ["targets"] } },
          "else": { "required": ["targets"], "not": { "required": ["custom_stat"] } }
        }
      ]
    }
  },
  "additionalProperties": false
}
