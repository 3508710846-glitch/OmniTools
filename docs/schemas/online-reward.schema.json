{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniTools online reward configuration",
  "type": "object",
  "required": ["format_version", "rewards"],
  "properties": {
    "format_version": { "const": 1 },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "minutes", "rewards"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}$" },
          "minutes": { "type": "integer", "minimum": 1 },
          "rewards": { "$ref": "common-rewards.schema.json#/$defs/rewards" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
