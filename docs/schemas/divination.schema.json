{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniTools Daily Divination Configuration",
  "type": "object",
  "required": ["format_version", "settings", "signs"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 2 },
    "settings": { "$ref": "#/$defs/settings" },
    "signs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/sign" }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "daily_free_draws", "max_daily_draws", "reroll_cost", "omen_buff_cap", "history_retention_days", "draw_cooldown_seconds", "broadcast_extremes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "daily_free_draws": { "const": 1 },
        "max_daily_draws": { "type": "integer", "minimum": 1, "maximum": 9 },
        "reroll_cost": { "type": "integer", "minimum": 0 },
        "omen_buff_cap": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "history_retention_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "draw_cooldown_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "broadcast_extremes": { "type": "boolean" }
      }
    },
    "sign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank", "weight", "poem", "interpretation", "favorable", "avoid", "advice", "skill_xp_modifier", "currency_reward"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
        "rank": { "enum": ["lower_lower", "lower", "middle", "upper", "upper_upper"] },
        "weight": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "theme": { "enum": ["random", "mining", "combat", "exploration", "trade", "social"] },
        "poem": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "interpretation": { "type": "string", "minLength": 1, "maxLength": 160 },
        "favorable": { "type": "string", "minLength": 1, "maxLength": 96 },
        "avoid": { "type": "string", "minLength": 1, "maxLength": 96 },
        "advice": { "type": "string", "minLength": 1, "maxLength": 160 },
        "skill_xp_modifier": { "type": "number", "minimum": -0.15, "maximum": 0.5 },
        "currency_reward": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    }
  }
}
